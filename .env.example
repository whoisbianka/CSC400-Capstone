# Copy to .env in the project root. Keep .env private; never commit credentials.
# demo (no connection), postgres (direct/local), or cloudsql (Google connector).
PROGRAM_DATA_SOURCE=demo
TUITION_BASIS=in_state

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASS=
# For local PostgreSQL only, set disable. Remote direct connections default to TLS.
DB_SSLMODE=verify-full

# Cloud SQL only; project:region:instance. Requires Google credentials and DB access.
INSTANCE_CONNECTION_NAME=
PRIVATE_IP=false
